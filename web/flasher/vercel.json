{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{"source":"/cardputer","destination":"/cardputer/index.html"},{"source":"/cardputer/","destination":"/cardputer/index.html"}],
  "headers": [
    {"source":"/(.*)","headers":[
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"X-Frame-Options","value":"DENY"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
      {"key":"Permissions-Policy","value":"serial=(self), camera=(), microphone=(), geolocation=()"},
      {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"}
    ]},
    {"source":"/firmware/CardGPT.bin","headers":[
      {"key":"Content-Disposition","value":"attachment; filename=\"CardGPT.bin\""},
      {"key":"Content-Type","value":"application/octet-stream"},
      {"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}
    ]},
    {"source":"/firmware/CardGPT-full.bin","headers":[
      {"key":"Content-Disposition","value":"attachment; filename=\"CardGPT-full.bin\""},
      {"key":"Content-Type","value":"application/octet-stream"},
      {"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}
    ]}
  ]
}
